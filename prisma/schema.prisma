// Prisma 스키마 - 영업 이메일 자동화 시스템
// DB 테이블을 정의하는 파일

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────
// 0. 멀티테넌트 (User / Tenant)
// ──────────────────────────────────────

enum UserRole {
  ADMIN     // 셀포 운영자 — 전체 데이터 접근
  CUSTOMER  // 고객 — 본인 Tenant 데이터만
}

enum TenantPlan {
  BASIC       // 월 ₩100,000 · 2,000건
  STANDARD    // 월 ₩199,000 · 8,000건
  PREMIUM     // 월 ₩399,000 · 20,000건
}

enum SetupStatus {
  PENDING         // 신규 계정 · 아직 세팅 안 함
  DOMAIN_BOUGHT   // 도메인 구매 완료
  DNS_DONE        // DNS (SPF/DKIM/DMARC) 설정 완료
  VERIFIED        // Brevo 도메인·sender 인증 완료
  ACTIVE          // 모든 세팅 완료 · 발송 가능
}

model Tenant {
  id                String      @id @default(uuid())
  companyName       String      // 회사명 (예: "강남사장 마케팅")
  domain            String?     // 전용 도메인 (예: kim-sales.com)
  senderEmail       String?     // 발송 이메일 (예: kim@kim-sales.com)
  senderName        String      // 발신자 표시명
  forwardTo         String?     // 답장 포워딩 주소 (고객의 기존 이메일)
  plan              TenantPlan  @default(BASIC)
  sendQuotaMonthly  Int         @default(2000) // 플랜별 월 할당량
  sendUsedThisMonth Int         @default(0)    // 이번 달 누적 발송
  setupStatus       SetupStatus @default(PENDING)
  brevoSenderId     Int?        // Brevo sender ID (인증 완료 시)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  users          User[]
  emailTemplates EmailTemplate[]
  emailSends     EmailSend[]
  hotLeads       HotLead[]
  deals          Deal[]
  senderProfiles SenderProfile[]

  @@index([domain])
  @@index([setupStatus])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(CUSTOMER)
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([tenantId])
  @@index([role])
}

// ──────────────────────────────────────
// 1. 업체 정보 (스크래퍼로 수집한 데이터 — 공용 풀)
// ──────────────────────────────────────
model Business {
  id            String    @id @default(uuid())
  name          String    // 업체명 (예: "강남 뷰티살롱")
  phone         String?   // 대표 전화번호
  personalPhone String?   // 개인번호 (010)
  email         String?   // 이메일
  naverId       String?   // 네이버 아이디
  address       String?   // 주소
  category      String?   // 업종 (미용실, 헬스장 등)
  region        String?   // 지역 (서울 강남 등)
  blogUrl       String?   // 블로그 URL
  homepageUrl   String?   // 홈페이지 URL
  placeId       String?   @unique // 네이버 Place ID (중복 방지)
  status        String    @default("active") // active / unsubscribed / bounced
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  emailSends    EmailSend[]
  pageVisits    PageVisit[]
  hotLead       HotLead?     // Phase 1: 1:1 유지, Phase 3 에서 1:many 로 변경 예정
  deals         Deal[]
  unsubscribe   Unsubscribe?

  @@index([email])
  @@index([category])
  @@index([region])
  @@index([status])
}

// ──────────────────────────────────────
// 2. 이메일 템플릿
// ──────────────────────────────────────
model EmailTemplate {
  id         String   @id @default(uuid())
  tenantId   String?  // 멀티테넌트 — null 이면 기존 데이터 (마이그레이션 후 '셀포' 로 채움)
  name       String   // 템플릿 이름
  step       Int      // 발송 단계 (1~4)
  subject    String   // 이메일 제목
  htmlBody   String   // HTML 본문
  textBody   String?  // 텍스트 본문
  category   String?  // 대상 업종 (null이면 전체)
  abVariant  String?  // A/B 테스트 변형 (A, B, C 등)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  emailSends EmailSend[]

  @@index([tenantId])
}

// ──────────────────────────────────────
// 3. 발송 기록
// ──────────────────────────────────────
model EmailSend {
  id             String    @id @default(uuid())
  tenantId       String?   // 멀티테넌트 — null 이면 기존 데이터
  businessId     String
  templateId     String?
  step           Int       // 몇 차 발송 (1~4)
  brevoMessageId String?   // Brevo 메시지 ID
  renderedSubject String?  // 실제 발송된 제목 (변수 치환 완료)
  renderedBody    String?  // 실제 발송된 HTML 본문 (변수 치환 완료)
  status         String    @default("queued") // queued/sent/delivered/bounced
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  bouncedAt      DateTime?
  bounceReason   String?
  repliedAt      DateTime?
  createdAt      DateTime  @default(now())

  tenant     Tenant?        @relation(fields: [tenantId], references: [id])
  business   Business       @relation(fields: [businessId], references: [id])
  template   EmailTemplate? @relation(fields: [templateId], references: [id])
  pageVisits PageVisit[]

  @@index([tenantId])
  @@index([businessId])
  @@index([status])
  @@index([step])
  @@index([sentAt])
}

// ──────────────────────────────────────
// 4. 랜딩페이지 방문 추적
// ──────────────────────────────────────
model PageVisit {
  id              String   @id @default(uuid())
  sendId          String?
  businessId      String
  visitedAt       DateTime @default(now())
  scrollPercent   Int      @default(0)
  durationSeconds Int      @default(0)
  clickCount      Int      @default(0)
  utmSource       String?
  utmCampaign     String?
  utmContent      String?

  send     EmailSend? @relation(fields: [sendId], references: [id])
  business Business   @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([sendId])
}

// ──────────────────────────────────────
// 5. 핫 리드 (관심 높은 업체)
// ──────────────────────────────────────
model HotLead {
  id           String    @id @default(uuid())
  tenantId     String?   // 멀티테넌트 — Phase 1 에선 nullable, Phase 3 에서 코드와 함께 unique 제약 변경 예정
  businessId   String    @unique // Phase 3 에서 @@unique([tenantId, businessId]) 로 변경 예정
  score        Float     @default(0)
  tier         String    @default("C") // S / A / B / C
  totalOpens   Int       @default(0)
  totalClicks  Int       @default(0)
  totalVisits  Int       @default(0)
  maxScroll    Int       @default(0)
  maxDuration  Int       @default(0)
  hasReplied   Boolean   @default(false)
  lastActivity DateTime?
  updatedAt    DateTime  @updatedAt

  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@index([tenantId])
  @@index([tier])
  @@index([score(sort: Desc)])
}

// ──────────────────────────────────────
// 6. 수신거부 (법적 필수)
// ──────────────────────────────────────
model Unsubscribe {
  id             String   @id @default(uuid())
  email          String   @unique
  businessId     String?  @unique
  reason         String?
  unsubscribedAt DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id])
}

// ──────────────────────────────────────
// 7. 수집 작업 기록
// ──────────────────────────────────────
model ScrapeJob {
  id             String    @id @default(uuid())
  region         String
  category       String
  mode           String    @default("place")
  maxResults     Int       @default(100)
  status         String    @default("pending") // pending/running/done/failed
  totalFound     Int       @default(0)
  totalSaved     Int       @default(0)
  withEmail      Int       @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  errorMessage   String?
  scheduled      Boolean   @default(false)
  cronExpression String?
  createdAt      DateTime  @default(now())

  progress ScrapeProgress?
  skipLogs ScrapeSkipLog[]
}

// 수집 진행 상황 추적 (실시간)
model ScrapeProgress {
  id              String   @id @default(uuid())
  jobId           String   @unique
  currentKeyword  String?
  currentRegion   String?
  currentBusiness String?
  totalProcessed  Int      @default(0)
  totalSkipped    Int      @default(0)
  lastUpdate      DateTime @default(now())

  job ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// 수집 스킵 로그 (멈춤/오류로 건너뛴 업체)
model ScrapeSkipLog {
  id           String   @id @default(uuid())
  jobId        String
  region       String
  keyword      String
  businessName String?
  reason       String   // timeout / frame_detached / iframe_failed / other
  skippedAt    DateTime @default(now())

  job ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([skippedAt])
}

// ──────────────────────────────────────
// 8. 거래/계약 (ROI 측정용)
// ──────────────────────────────────────
model Deal {
  id             String   @id @default(uuid())
  tenantId       String?  // 멀티테넌트 — 테넌트별로 계약 따로 관리
  businessId     String
  stage          String   @default("replied") // replied / meeting / contracted
  amount         Float?
  notes          String?
  stageChangedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@index([tenantId])
  @@index([businessId])
}

// ──────────────────────────────────────
// 9. 발신자 프로필 (서비스별 발신 정보)
// ──────────────────────────────────────
model SenderProfile {
  id              String   @id @default(uuid())
  tenantId        String?  // 멀티테넌트 — 테넌트별 발신자. null 이면 기존/공용
  serviceName     String   // 서비스명 (예: 셀포, 다른서비스)
  senderName      String   // 발신자 표시명 (예: "셀포 by 마스터인사이트")
  senderEmail     String   // 발신 이메일
  companyName     String   // 사업자명 (예: (주)마스터인사이트)
  representative  String?  // 대표자명
  address         String?  // 주소
  phone           String?  // 연락처
  businessNumber  String?  // 사업자등록번호
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
